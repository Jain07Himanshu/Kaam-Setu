generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  role         String   @default("CUSTOMER") // CUSTOMER, WORKER, ADMIN
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile  CustomerProfile?
  workerProfile    WorkerProfile?
  serviceLocations ServiceLocation[]
  notifications    Notification[]
  supportTickets   SupportTicket[]
  givenReviews     Review[]          @relation("GivenReviews")
  receivedReviews  Review[]          @relation("ReceivedReviews")
  auditEvents      AuditEvent[]
}

model CustomerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  preferredAddress String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRequests JobRequest[]
  bookings    Booking[]
}

model WorkerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  bio                String?
  skills             String   @default("[]") // JSON string of skills
  serviceRadiusKm    Float    @default(15.0)
  hourlyRate         Float?
  baseRate           Float?
  isAvailable        Boolean  @default(true)
  onboardingStatus   String   @default("COMPLETED") // COMPLETED, IN_PROGRESS, PENDING
  ratingAvg          Float    @default(5.0)
  ratingCount        Int      @default(0)
  completedJobsCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications  WorkerVerification[]
  workerServices WorkerService[]
  jobOffers      JobOffer[]
  quotes         Quote[]
  bookings       Booking[]
}

model WorkerVerification {
  id         String    @id @default(uuid())
  workerId   String
  type       String // PHONE, ID_DOCUMENT, SKILL_CERT, BACKGROUND_CHECK
  status     String    @default("VERIFIED") // VERIFIED, PENDING, REJECTED, NOT_STARTED
  notes      String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model ServiceCategory {
  id                String   @id @default(uuid())
  name              String   @unique
  slug              String   @unique
  description       String
  icon              String
  active            Boolean  @default(true)
  basePriceEstimate Float?
  createdAt         DateTime @default(now())

  workerServices WorkerService[]
  jobRequests    JobRequest[]
}

model WorkerService {
  id                String   @id @default(uuid())
  workerId          String
  serviceCategoryId String
  experienceYears   Int      @default(3)
  customRate        Float?
  createdAt         DateTime @default(now())

  worker          WorkerProfile   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@unique([workerId, serviceCategoryId])
}

model ServiceLocation {
  id         String   @id @default(uuid())
  userId     String
  label      String
  address    String
  unit       String?
  city       String   @default("Metro Area")
  postalCode String   @default("10001")
  latitude   Float    @default(40.7128)
  longitude  Float    @default(-74.0060)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobRequest {
  id                String    @id @default(uuid())
  customerId        String
  serviceCategoryId String
  title             String
  description       String
  addressLabel      String
  city              String    @default("Metro Area")
  postalCode        String    @default("10001")
  latitude          Float     @default(40.7128)
  longitude         Float     @default(-74.0060)
  budgetMin         Float?
  budgetMax         Float?
  isOpenToQuotes    Boolean   @default(true)
  urgency           String    @default("ASAP") // ASAP, SCHEDULED
  scheduledAt       DateTime?
  status            String    @default("OPEN") // OPEN, MATCHING, OFFERS_RECEIVED, IN_NEGOTIATION, BOOKED, CANCELLED, COMPLETED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id])
  offers          JobOffer[]
  quotes          Quote[]
  booking         Booking?
}

model JobOffer {
  id           String    @id @default(uuid())
  jobRequestId String
  workerId     String
  status       String    @default("PENDING") // PENDING, VIEWED, QUOTED, DECLINED, EXPIRED
  matchScore   Float     @default(90.0)
  matchReasons String    @default("[]") // JSON string array of reasons
  sentAt       DateTime  @default(now())
  expiresAt    DateTime?
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())

  jobRequest JobRequest    @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([jobRequestId, workerId])
}

model Quote {
  id                      String   @id @default(uuid())
  jobRequestId            String
  workerId                String
  proposedPrice           Float
  estimatedArrivalMinutes Int      @default(30)
  scopeDescription        String
  exclusions              String?
  workerNote              String?
  status                  String   @default("PENDING") // PENDING, COUNTEROFFERED, ACCEPTED, REJECTED, EXPIRED
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  jobRequest   JobRequest         @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  worker       WorkerProfile      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  negotiations QuoteNegotiation[]
  booking      Booking?
}

model QuoteNegotiation {
  id            String   @id @default(uuid())
  quoteId       String
  senderId      String
  senderRole    String // CUSTOMER, WORKER
  proposedPrice Float
  message       String
  createdAt     DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Booking {
  id                 String    @id @default(uuid())
  jobRequestId       String    @unique
  customerId         String
  workerId           String
  acceptedQuoteId    String    @unique
  agreedPrice        Float
  agreedScope        String
  scheduledAt        DateTime?
  startOtp           String    @default("4921")
  status             String    @default("CONFIRMED") // CONFIRMED, ON_THE_WAY, WORK_STARTED, COMPLETED, CANCELLED, DISPUTED
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  jobRequest    JobRequest      @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  worker        WorkerProfile   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  acceptedQuote Quote           @relation(fields: [acceptedQuoteId], references: [id], onDelete: Cascade)
  review        Review?
}

model Notification {
  id                String    @id @default(uuid())
  recipientUserId   String
  type              String // JOB_OFFER_RECEIVED, QUOTE_RECEIVED, etc.
  title             String
  message           String
  relatedEntityType String // JOB_REQUEST, QUOTE, BOOKING, SUPPORT_TICKET
  relatedEntityId   String
  readAt            DateTime?
  createdAt         DateTime  @default(now())

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  reviewerId String
  revieweeId String
  rating     Int      @default(5)
  comment    String
  createdAt  DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer User    @relation("GivenReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User    @relation("ReceivedReviews", fields: [revieweeId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  bookingId   String?
  category    String   @default("GENERAL") // GENERAL, BOOKING_ISSUE, PAYMENT_QUERY, SAFETY_REPORT
  subject     String
  description String
  status      String   @default("OPEN") // OPEN, IN_REVIEW, RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   String   @default("{}") // JSON string
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}
