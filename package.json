{
  "name": "hyperlocal-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "server"
  ],
  "scripts": {
    "prisma:generate": "npm --workspace=@hyperlocal/server run prisma:generate",
    "prisma:push": "npm --workspace=@hyperlocal/server run prisma:push",
    "prisma:seed": "npm --workspace=@hyperlocal/server run prisma:seed",
    "db:setup": "npm run prisma:generate && npm run prisma:push && npm run prisma:seed",
    "dev:server": "npm --workspace=@hyperlocal/server run dev",
    "dev:customer": "npm --workspace=@hyperlocal/customer-app run dev",
    "dev:worker": "npm --workspace=@hyperlocal/worker-app run dev",
    "build:server": "npm --workspace=@hyperlocal/server run build",
    "build:customer": "npm --workspace=@hyperlocal/customer-app run build",
    "build:worker": "npm --workspace=@hyperlocal/worker-app run build",
    "build": "npm run build:server && npm run build:customer && npm run build:worker"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
